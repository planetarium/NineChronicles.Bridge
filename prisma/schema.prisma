// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestType {
  UNLOAD_FROM_MY_GARAGES
  TRANSFER_ASSET
}

enum RequestCategory {
  PROCESS
  REFUND
  IGNORE
}

enum ResponseType {
  MINT_ASSETS
  TRANSFER_ASSET
  BURN_ASSET
}

enum TxResult {
  INVALID
  STAGING
  SUCCESS
  FAILURE
  INCLUDED
}

model Network {
  id                   String                @id
  requestTransactions  RequestTransaction[]
  responseTransactions ResponseTransaction[]
  blocks               Block[]
}

model Block {
  index BigInt

  networkId String
  network   Network @relation(fields: [networkId], references: [id])

  transactions RequestTransaction[]

  @@id([index, networkId])
}

model RequestTransaction {
  id       String          @id
  category RequestCategory
  type     RequestType

  networkId String
  network   Network @relation(fields: [networkId], references: [id])

  blockIndex BigInt
  block      Block  @relation(fields: [blockIndex, networkId], references: [index, networkId])

  createdAt DateTime @default(now())

  sender String

  executions ResponseTransaction[]
}

// Production has two hand-made indexes on this table that are intentionally NOT
// managed by Prisma migrations (Prisma cannot express the partial index, and
// declaring only one of them here would make `prisma migrate dev` diff against
// prod). Create them manually in a new environment:
//
//   CREATE INDEX IF NOT EXISTS ix_resptx_pending
//     ON "ResponseTransaction" ("statusUpdatedAt")
//     WHERE ("lastStatus" NOT IN ('FAILURE', 'SUCCESS') OR "lastStatus" IS NULL);
//   CREATE INDEX IF NOT EXISTS ix_resptx_network_nonce
//     ON "ResponseTransaction" ("networkId", nonce DESC);
//
// src/sync/txresult.ts relies on ix_resptx_pending and uses raw SQL with literal
// enum values so the planner can match the partial-index predicate.
model ResponseTransaction {
  id    String @unique
  nonce BigInt
  raw   Bytes

  type ResponseType

  lastStatus      TxResult?
  statusUpdatedAt DateTime  @default(now()) @updatedAt

  networkId String
  network   Network @relation(fields: [networkId], references: [id])

  requestTransactionId String
  RequestTransaction   RequestTransaction @relation(fields: [requestTransactionId], references: [id])

  @@id([nonce, networkId])
}
